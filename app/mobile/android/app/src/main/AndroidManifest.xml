<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Sem cópias de segurança dos dados do app: a sessão da conta fica guardada no WebView, e com
      elas ia para a Google Drive e para o telemóvel novo sem novo login. O que a pessoa tem
      (encomendas, biblioteca, carrinho) está na conta, não no aparelho.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- O regresso do login com a Google (lib/nativeAuth.js): ao.livrariaadventista.app://auth/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="auth" />
            </intent-filter>

            <!-- As ligações do site abrem no app (App Links: /.well-known/assetlinks.json, scripts/ligacoes-app.mjs) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="livrariaadventista.ao" />
                <data android:host="www.livrariaadventista.ao" />
            </intent-filter>

        </activity>

        <!-- O trajeto de quem entrega com o ecrã apagado (TrajetoService.java, docs/TRAJETO_GPS.md):
             começa com o app à frente, por isso basta a localização «durante a utilização». -->
        <service
            android:name=".TrajetoService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissões -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lojas perto, ponto de entrega e o trajeto de quem entrega -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- O trajeto continua com o ecrã apagado: serviço em primeiro plano do tipo localização -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Notificações das encomendas, da comunidade e das novidades (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibração leve ao juntar ao carrinho -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
