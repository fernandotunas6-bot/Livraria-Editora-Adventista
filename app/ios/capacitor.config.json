{
  "appId": "ao.livrariaadventista.app",
  "appName": "Livraria Adventista",
  "webDir": "www",
  "server": {
    "url": "https://livrariaadventista.ao",
    "errorPath": "offline.html"
  },
  "ios": {
    "appendUserAgent": "LivrariaAdventistaApp/1 (iOS)",
    "contentInset": "never",
    "backgroundColor": "#ffffff",
    "allowsLinkPreview": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 10000,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    }
  }
}
