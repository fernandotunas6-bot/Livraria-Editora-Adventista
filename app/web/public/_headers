# Cabeçalhos servidos pelo Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# O Pages já envia `referrer-policy: strict-origin-when-cross-origin` e
# `x-content-type-options: nosniff`; ficam aqui explícitos para não depender do padrão dele.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # A loja usa a localização para "lojas perto de mim" (StoresPage) e para as coordenadas das
  # lojas no painel. O microfone só para o próprio site: a narração com a própria voz no Estúdio
  # de vídeo dos relatórios (estudio-video.js), que só o pede quando alguém da equipa a liga.
  # Câmara e sensores de pagamento nunca são usados.
  Permissions-Policy: geolocation=(self), camera=(), microphone=(self), payment=(), usb=()
  # Política de segurança de conteúdo. As origens foram levantadas do que o navegador
  # carrega de facto (`performance.getEntriesByType('resource')`), não só do código: a loja
  # usa o Supabase e as fontes do Google, e o painel acrescenta as APIs do Google Workspace.
  #
  # `script-src` sem `unsafe-inline`: o único script embutido que havia — o registo do
  # service worker — passou para `/sw-register.js` por causa disto. `unsafe-inline` em
  # scripts tornaria a política quase decorativa, porque é precisamente assim que um script
  # injectado numa descrição de livro correria.
  #
  # `style-src` mantém `unsafe-inline`, que não é opcional: o React e o Tailwind escrevem
  # estilos directamente nos elementos, e o `style=` de cada um conta como estilo embutido.
  # O risco de um estilo injectado é muito menor do que o de um script.
  #
  # `frame-src` inclui o OpenStreetMap e o Google Maps: o mapa de cada loja é um `iframe`
  # de uma dessas origens — o OSM quando não há chave configurada, o Google quando há. Eles
  # faltavam na primeira versão desta política e o mapa das lojas ficou em branco em
  # produção, sem nada na página a dizê-lo; só a consola acusava o bloqueio.
  #
  # `www.youtube-nocookie.com` é o vídeo de apresentação dos produtos (`lib/youtube.js`). É o
  # domínio sem cookies de publicidade: o `youtube.com` normal escreve-os só por a moldura
  # existir, o que obrigaria a um aviso de cookies que a loja não tem. Só este domínio entra,
  # e a moldura só é criada depois de alguém carregar na miniatura.
  #
  # `img-src` aceita qualquer `https:`. A lista fechada (Supabase, Google, Drive) deixava as
  # capas das quatro colecções em branco — estão no Unsplash — e o painel diz para colar
  # "um link directo (CDN, Unsplash)", ou seja, qualquer endereço. Uma imagem não executa
  # nada; o que o CSP tem de travar são os scripts, e esses continuam fechados.
  #
  # `frame-ancestors 'self'` faz o mesmo que o `X-Frame-Options` acima, mas é a forma que os
  # navegadores actuais respeitam; os dois ficam, para os antigos também.
  #
  # `script-src` deixa entrar o `static.cloudflareinsights.com` porque, com o site servido pelo
  # Cloudflare, é o próprio edge que injecta o beacon do Web Analytics no HTML do domínio
  # próprio — não vem do nosso código nem aparece no `.pages.dev`. Sem esta entrada o CSP
  # bloqueava-o: duas linhas de erro na consola em cada página e nenhuma estatística recolhida.
  # O beacon reporta para `/cdn-cgi/rum`, no próprio domínio, que o `connect-src 'self'` cobre.
  #
  # `challenges.cloudflare.com` (script e moldura) é o Cloudflare Turnstile dos formulários públicos
  # (components/TurnstileWidget.jsx), que só carrega quando a loja o liga.
  #
  # Os domínios da Google em `script-src` são do painel (Google Workspace, selector do Drive). Nas
  # páginas da loja, o site junta uma segunda política só com o próprio site, o beacon e o Turnstile
  # (lib/storeCsp.js): os navegadores aplicam as duas, por isso lá esses domínios não entram.
  #
  # HSTS com `includeSubDomains` (um ano): todos os subdomínios já servem HTTPS ("Always Use HTTPS"
  # no Cloudflare). Sem `preload`, que é difícil de desfazer.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://apis.google.com https://accounts.google.com https://www.googleapis.com https://www.gstatic.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.googleapis.com https://accounts.google.com https://*.firebaseio.com https://*.firebaseapp.com; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com https://drive.google.com https://www.openstreetmap.org https://www.google.com https://www.youtube-nocookie.com https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Ficheiros com hash no nome: o conteúdo nunca muda para o mesmo nome.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O HTML e o service worker têm de ser sempre os actuais, senão uma publicação nova só
# aparece ao segundo recarregamento (ou dá página em branco, a apontar para assets antigos).
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
# A versão publicada, que a app aberta lê para saber se há uma nova (scripts/app-version.mjs):
# uma cópia velha em qualquer cache escondia a versão nova.
/version.json
  Cache-Control: no-store
# O ficheiro que liga o site ao app iOS (scripts/ligacoes-app.mjs, gerado no deploy).
# Não tem extensão, e sem isto o Pages servia-o como binário.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# A app Android para descarregar (deploy-cloudflare.yml copia-a da Release do «App Android»).
# O tipo certo faz o Android oferecer «Instalar» ao abrir; o nome do ficheiro fica o da loja. O
# endereço é sempre o mesmo e o ficheiro muda a cada versão: o navegador confirma antes de usar
# a cópia que tem.
/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="livraria-adventista.apk"
  Cache-Control: no-cache
