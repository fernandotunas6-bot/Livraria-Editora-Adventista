{
  "openapi": "3.1.0",
  "info": {
    "title": "KanGest Core API (Livraria Editora Adventista)",
    "version": "1",
    "description": "A API v1 do ecossistema KANGEST ONE, na Edge Function `app` do Supabase. As respostas vêm em `{ data }` (e `next_cursor` nas listas); os erros em `{ error: { status, message }, ref }`. As escritas levam `Idempotency-Key`. Cada rota declara o acesso em `x-acesso` (conferido contra o código por supabase/functions/app/apiV1.test.ts); `x-reutiliza` diz a rota antiga de que é o mesmo handler e o mesmo acesso."
  },
  "servers": [
    {
      "url": "https://{projecto}.supabase.co/functions/v1/app",
      "variables": {
        "projecto": {
          "default": "bggqkjjqbjhbjsckzopj"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "sessao": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A sessão do Supabase Auth da pessoa (o mesmo token do site e do KanGest). A equipa precisa dos dois passos."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "8 a 100 letras, algarismos ou _ . : - ; o mesmo valor repetido nas 24 horas seguintes devolve a primeira resposta (com o cabeçalho Idempotent-Replayed).",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{8,100}$"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "description": "O next_cursor da página anterior.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Erro": {
        "description": "Erro.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error",
                "ref"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "required": [
                    "status",
                    "message"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "ref": {
                  "type": "string",
                  "description": "O id do pedido, para procurar nos registos."
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
