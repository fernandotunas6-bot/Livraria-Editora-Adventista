# CLI do Supabase (`.branches` aparece com `supabase db start` / `supabase start` locais)
supabase/.temp/
supabase/.branches/

# Configuração da Pages Function da comunidade, gerada no pós-build (scripts/seo-catalogo.mjs)
scripts/gerado/

# Registo da Igreja: ficheiros de origem com dados pessoais (telefones, avaliações dos pastores).
# Importam-se pelo painel (Igreja → Registo da Igreja → Importar); não vão para o repositório.
/churches.json
/pastores.json

# Fotografias originais dos produtos (52 MB; o levantamento está em docs/catalogo)
Novos livros/
livraria Adventista.jpeg

# Testes de ponta a ponta (Playwright): resultados, capturas e relatório de cada corrida
app/web/test-results/
app/web/playwright-report/

# Exportações do KiGest, o programa de facturação da loja. Trazem a base de dados inteira:
# clientes, facturas, contas correntes e salários. Do catálogo faz-se uma migração (ver
# docs/catalogo/KIGEST.md); o ficheiro em si nunca vai para o repositório.
KIGEST-exportacao-*.kigest
*.kigest

# Python compilado
__pycache__/
*.pyc

# Chaves da Apple (App Store Connect e APNs): vão para os segredos do GitHub e do Supabase,
# nunca para o repositório (docs/APPS.md).
*.p8
# Android: a chave de envio para a Play Store e o ficheiro do Firebase vêm dos segredos do GitHub
# (.github/workflows/android.yml), nunca do repositório.
*.jks
*.keystore
app/mobile/android/app/google-services.json
